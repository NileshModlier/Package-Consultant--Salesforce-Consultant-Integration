<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>After commit, publish Intake_Status__e when an intake Lead is created or its status or owner changes. Runs after Lead Intake Handling so a queue assignment is included.</description>
    <environments>Default</environments>
    <interviewLabel>Lead Status Publisher {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead Status Publisher</label>
    <processType>AutoLaunchedFlow</processType>
    <assignments>
        <name>Set_Blank_Name</name>
        <label>Owner name unavailable</label>
        <locationX>440</locationX>
        <locationY>600</locationY>
        <assignmentItems>
            <assignToReference>OwnerName</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Publish_Intake_Status</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Queue_Name</name>
        <label>Use queue name</label>
        <locationX>176</locationX>
        <locationY>600</locationY>
        <assignmentItems>
            <assignToReference>OwnerName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Queue_Owner.Name</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Publish_Intake_Status</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_User_Name</name>
        <label>Use user name</label>
        <locationX>176</locationX>
        <locationY>384</locationY>
        <assignmentItems>
            <assignToReference>OwnerName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_User_Owner.Name</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Publish_Intake_Status</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Queue_Found</name>
        <label>Queue found</label>
        <locationX>308</locationX>
        <locationY>492</locationY>
        <defaultConnector>
            <targetReference>Set_Blank_Name</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No queue</defaultConnectorLabel>
        <rules>
            <name>Queue_Owner</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Queue_Owner.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Queue_Name</targetReference>
            </connector>
            <label>Queue owner</label>
        </rules>
    </decisions>
    <decisions>
        <name>User_Found</name>
        <label>User found</label>
        <locationX>176</locationX>
        <locationY>276</locationY>
        <defaultConnector>
            <targetReference>Get_Queue_Owner</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not a user</defaultConnectorLabel>
        <rules>
            <name>User_Owner</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_User_Owner.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_User_Name</targetReference>
            </connector>
            <label>User owner</label>
        </rules>
    </decisions>
    <recordCreates>
        <name>Publish_Intake_Status</name>
        <label>Publish intake status</label>
        <locationX>176</locationX>
        <locationY>792</locationY>
        <inputAssignments>
            <field>Intake_Ref__c</field>
            <value>
                <elementReference>$Record.Intake_Ref__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Object_Type__c</field>
            <value>
                <stringValue>Lead</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Owner_Name__c</field>
            <value>
                <elementReference>OwnerName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <elementReference>$Record.Status</elementReference>
            </value>
        </inputAssignments>
        <object>Intake_Status__e</object>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Queue_Owner</name>
        <label>Get queue owner</label>
        <locationX>308</locationX>
        <locationY>384</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Queue_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_User_Owner</name>
        <label>Get user owner</label>
        <locationX>176</locationX>
        <locationY>168</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>User_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_User_Owner</targetReference>
        </connector>
        <filterFormula>AND(NOT(ISBLANK({!$Record.Intake_Ref__c})), OR(ISNEW(), ISCHANGED({!$Record.Status}), ISCHANGED({!$Record.OwnerId})))</filterFormula>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerOrder>20</triggerOrder>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>OwnerName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
