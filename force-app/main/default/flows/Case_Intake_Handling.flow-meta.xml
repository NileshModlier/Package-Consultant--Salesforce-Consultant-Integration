<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>When an intake reference is first stored on a Case, assign the Case to the Support Tier 1 queue. High priority creates an urgent response task. Any other priority creates a standard response task. If a High case is still New after 4 hours, or any intake case is still New after 24 hours, create a monitoring task.</description>
    <environments>Default</environments>
    <formulas>
        <name>MonitorTaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Response still outstanding &quot; &amp; {!$Record.Intake_Ref__c}</expression>
    </formulas>
    <formulas>
        <name>ResponseTaskDescription</name>
        <dataType>String</dataType>
        <expression>&quot;Channel: &quot; &amp; TEXT({!$Record.Intake_Channel__c}) &amp; BR() &amp; &quot;Priority: &quot; &amp; TEXT({!$Record.Priority}) &amp; BR() &amp; &quot;Read Intake Summary on the case. Do not replace Intake Ref.&quot;</expression>
    </formulas>
    <formulas>
        <name>StandardTaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Respond to intake &quot; &amp; {!$Record.Intake_Ref__c}</expression>
    </formulas>
    <formulas>
        <name>Today</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>UrgentMonitorSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Urgent response still outstanding &quot; &amp; {!$Record.Intake_Ref__c}</expression>
    </formulas>
    <formulas>
        <name>UrgentTaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Urgent intake response &quot; &amp; {!$Record.Intake_Ref__c}</expression>
    </formulas>
    <interviewLabel>Case Intake Handling {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case Intake Handling</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_High_Response_Monitor_Task</name>
        <label>Create high response monitor task</label>
        <locationX>176</locationX>
        <locationY>900</locationY>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>Today</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>ResponseTaskDescription</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>UrgentMonitorSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordCreates>
