    <recordLookups>
        <name>Get_Support_Tier_1_Queue</name>
        <label>Get Support Tier 1 queue</label>
        <locationX>308</locationX>
        <locationY>168</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Queue_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Support_Tier_1</stringValue>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Assign_To_Support_Tier_1</name>
        <label>Assign to Support Tier 1</label>
        <locationX>308</locationX>
        <locationY>384</locationY>
        <connector>
            <targetReference>Priority_Is_High</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>Get_Support_Tier_1_Queue.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <decisions>
        <name>High_Still_New</name>
        <label>High and still new</label>
        <locationX>176</locationX>
        <locationY>780</locationY>
        <defaultConnectorLabel>No four-hour alert</defaultConnectorLabel>
        <rules>
            <name>High_Priority_And_New</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Priority</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>High</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_High_Response_Monitor_Task</targetReference>
            </connector>
            <label>High and New</label>
        </rules>
    </decisions>
    <decisions>
        <name>Priority_Is_High</name>
        <label>Priority is high</label>
        <locationX>308</locationX>
        <locationY>480</locationY>
        <defaultConnector>
            <targetReference>Create_Standard_Response_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Standard priority</defaultConnectorLabel>
        <rules>
            <name>High</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Priority</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>High</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Urgent_Response_Task</targetReference>
            </connector>
            <label>High</label>
        </rules>
    </decisions>
    <decisions>
        <name>Queue_Found</name>
        <label>Queue found</label>
        <locationX>308</locationX>
        <locationY>276</locationY>
        <defaultConnector>
            <targetReference>Support_Tier_1_Queue_Missing</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Queue missing</defaultConnectorLabel>
        <rules>
            <name>Support_Tier_1_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Support_Tier_1_Queue.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_To_Support_Tier_1</targetReference>
            </connector>
            <label>Support Tier 1 found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Still_New</name>
        <label>Still new</label>
        <locationX>700</locationX>
        <locationY>780</locationY>
        <defaultConnectorLabel>Already moved</defaultConnectorLabel>
        <rules>
            <name>Status_Is_New</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Response_Monitor_Task</targetReference>
            </connector>
            <label>New</label>
        </rules>
    </decisions>
    <customErrors>
        <name>Support_Tier_1_Queue_Missing</name>
        <label>Support Tier 1 queue missing</label>
        <locationX>572</locationX>
        <locationY>384</locationY>
        <customErrorMessages>
            <errorMessage>The Support Tier 1 queue is not available, so this intake case was not saved.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <start>
        <locationX>308</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Support_Tier_1_Queue</targetReference>
        </connector>
        <filterFormula>AND(NOT(ISBLANK({!$Record.Intake_Ref__c})), OR(ISNEW(), ISCHANGED({!$Record.Intake_Ref__c})))</filterFormula>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerOrder>10</triggerOrder>
        <scheduledPaths>
            <name>Monitor_High_At_4_Hours</name>
            <connector>
                <targetReference>High_Still_New</targetReference>
            </connector>
            <label>Monitor high priority at 4 hours</label>
            <offsetNumber>4</offsetNumber>
            <offsetUnit>Hours</offsetUnit>
            <recordField>CreatedDate</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <scheduledPaths>
            <name>Monitor_Open_At_24_Hours</name>
            <connector>
                <targetReference>Still_New</targetReference>
            </connector>
            <label>Monitor any open intake at 24 hours</label>
            <offsetNumber>24</offsetNumber>
            <offsetUnit>Hours</offsetUnit>
            <recordField>CreatedDate</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
