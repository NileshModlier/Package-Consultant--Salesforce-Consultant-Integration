<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Intake_Summary_Required</fullName>
    <active>true</active>
    <description>An intake lead must carry the customer summary.</description>
    <errorConditionFormula>AND(
  NOT(ISBLANK(Intake_Ref__c)),
  ISBLANK(Intake_Summary__c)
)</errorConditionFormula>
    <errorDisplayField>Intake_Summary__c</errorDisplayField>
    <errorMessage>Intake Summary is required when Intake Ref is set.</errorMessage>
</ValidationRule>
